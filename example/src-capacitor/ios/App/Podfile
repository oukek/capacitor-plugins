require_relative '../../../../node_modules/.pnpm/@capacitor+ios@7.0.0_@capacitor+core@7.4.3/node_modules/@capacitor/ios/scripts/pods_helpers'

platform :ios, '15.0'
use_frameworks!

# workaround to avoid Xcode caching of Pods that requires
# Product -> Clean Build Folder after new Cordova plugins installed
# Requires CocoaPods 1.6 or newer
install! 'cocoapods', :disable_input_output_paths => true

def capacitor_pods
  pod 'Capacitor', :path => '../../../../node_modules/.pnpm/@capacitor+ios@7.0.0_@capacitor+core@7.4.3/node_modules/@capacitor/ios'
  pod 'CapacitorCordova', :path => '../../../../node_modules/.pnpm/@capacitor+ios@7.0.0_@capacitor+core@7.4.3/node_modules/@capacitor/ios'
  pod 'CapacitorApp', :path => '../../../../node_modules/.pnpm/@capacitor+app@7.1.0_@capacitor+core@7.4.3/node_modules/@capacitor/app'
  pod 'CapacitorToast', :path => '../../../../node_modules/.pnpm/@capacitor+toast@7.0.2_@capacitor+core@7.4.3/node_modules/@capacitor/toast'
  pod 'OukekCapacitorClipboard', :path => '../../../../packages/clipboard'
  pod 'OukekCapacitorPay', :path => '../../../../packages/pay'
  pod 'OukekCapacitorPhoto', :path => '../../../../packages/photo'
  pod 'OukekCapacitorCalendar', :path => '../../../../packages/calendar'
  pod 'OukekCapacitorSpeech', :path => '../../../../packages/speech'
end

target 'App' do
  capacitor_pods
  # Add your Pods here
end

post_install do |installer|
  assertDeploymentTarget(installer)
end
